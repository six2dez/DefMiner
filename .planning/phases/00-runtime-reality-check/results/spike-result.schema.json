{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defminer.local/schemas/spike-result.schema.json",
  "title": "Phase 0 per-spike result",
  "description": "The contract every Phase 0 spike writes into. Later phases read go-no-go.json, not this \u2014 but go-no-go.json is assembled from these, so a field missing here is a field plan 00-04 cannot aggregate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spike",
    "status",
    "recorded_at",
    "binary",
    "host",
    "instances",
    "method",
    "measurements",
    "verdict",
    "requirements_affected"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spike": {
      "type": "string",
      "description": "Phase 0 requirement id. The optional lowercase suffix carries a sub-spike (SPIKE-04b) that has its own requirement line in REQUIREMENTS.md and therefore its own gate in go-no-go.json.",
      "pattern": "^SPIKE-[0-9]{2}[a-z]?$"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "blocked"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "expected_version",
        "reported_version"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "expected_version": {
          "type": "string"
        },
        "reported_version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "host": {
      "type": "object",
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "cores": {
          "type": [
            "integer",
            "null"
          ]
        },
        "ram_gb": {
          "type": [
            "number",
            "null"
          ]
        },
        "loadavg_1m": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "listen"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "data_path": {
            "type": "string"
          },
          "listen": {
            "type": "string"
          },
          "fresh": {
            "type": "boolean"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "project_persistence": {
            "enum": [
              "temporary",
              "persistent",
              "none",
              null
            ]
          }
        }
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "tier": {
          "enum": [
            "raw-zip",
            "caido-dev-build",
            "none"
          ]
        },
        "package_version": {
          "type": "string"
        },
        "bundle_sha256": {
          "type": "string"
        },
        "deps": {
          "type": "object"
        }
      }
    },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "value",
          "unit"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "primitive": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          },
          "stat": {
            "enum": [
              "point",
              "median",
              "mean",
              "p95",
              "p99",
              "max",
              "min",
              "sum",
              "count",
              "ratio"
            ]
          },
          "p95": {
            "type": [
              "number",
              "null"
            ]
          },
          "n": {
            "type": [
              "integer",
              "null"
            ]
          },
          "valid": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "containment": {
      "type": "object",
      "required": [
        "escaped"
      ],
      "properties": {
        "escaped": {
          "type": "boolean"
        },
        "escape_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer",
        "confidence",
        "thresholds_set",
        "if_wrong"
      ],
      "properties": {
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW",
            "PENDING"
          ]
        },
        "if_wrong": {
          "type": "string",
          "minLength": 1
        },
        "thresholds_set": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "value",
              "unit",
              "confidence"
            ],
            "properties": {
              "id": {
                "enum": [
                  "REDOS_INTERRUPTIBLE",
                  "REDOS_RECOVERY",
                  "RE2JS_THROUGHPUT_RATIO",
                  "RE2JS_VERDICT",
                  "YIELD_PRIMITIVE",
                  "YIELD_COST_MS",
                  "MAX_SYNC_SLICE_MS",
                  "EVENT_OVERFLOW_BEHAVIOUR",
                  "EVENTS_DELIVERED_UNDER_BLOCK",
                  "HANDLER_ERROR_SURFACED",
                  "SEND_CLIFF_SAVE_TRUE",
                  "SEND_CLIFF_SAVE_FALSE",
                  "SEND_CLIFF_FETCH",
                  "SEND_FAILURE_MODE",
                  "PLUGIN_TOGGLE_RESETS_LEAK",
                  "SEND_REFIRES_INTERCEPT",
                  "SAVE_FALSE_SUPPRESSES_INTERCEPT",
                  "PLUGINS_FALSE_SUPPRESSES_INTERCEPT",
                  "SURFACES_FIRING_INTERCEPT",
                  "AST_MAX_BYTES",
                  "HARD_MAX_BYTES",
                  "MAX_NESTING_DEPTH",
                  "STACK_FAILURE_MODE",
                  "PARSE_MS_PER_MB",
                  "RSS_BYTES_PER_INPUT_BYTE",
                  "STRUCTURED_CLONE_PRESENT",
                  "WASM_PRESENT",
                  "TEXTDECODER_MODULE",
                  "TRIVIAL_STACK_DEPTH",
                  "BODY_STORED_DECOMPRESSED",
                  "BODY_LENGTH_EQUALS_RAW_LENGTH",
                  "SIZE_GATE_SOURCE",
                  "PRAGMA_PERSISTS_ACROSS_EXEC",
                  "TRANSACTION_PERSISTS_ACROSS_EXEC",
                  "MULTISTATEMENT_EXEC_ATOMIC",
                  "WAL_ENABLED",
                  "DB_SURVIVES_REINSTALL",
                  "CACHE_HIT_RATE_WITHIN_PAGE",
                  "CACHE_HIT_RATE_WITHIN_SESSION",
                  "CACHE_HIT_RATE_CROSS_DAY",
                  "CACHE_HIT_RATE_ASSUMED",
                  "CACHE_SAMPLE_DAYS",
                  "CACHE_CROSS_DAY_DENOMINATOR",
                  "CACHED_RESPONSES_REACH_HOOK",
                  "STATUS_304_REACHES_HOOK",
                  "RETROACTIVE_SCAN_MANDATORY",
                  "FS_HAS_REALPATH",
                  "FS_HAS_LSTAT",
                  "FS_CONTAINMENT_STRATEGY"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ],
                "description": "Nullable ONLY to carry the single inconclusive case plan 00-04 task 3 defines for the cross-day cache rate. Every other threshold in the phase must resolve to a real value."
              },
              "unit": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "PENDING"
                ]
              },
              "status": {
                "enum": [
                  "resolved",
                  "inconclusive",
                  "pending"
                ]
              },
              "rationale": {
                "type": "string"
              },
              "revisit_after": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "requirements_affected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
