{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defminer.local/schemas/go-no-go.schema.json",
  "title": "Phase 0 go/no-go aggregate",
  "description": "The ONLY Phase 0 artifact later phases may import. Assembled in plan 00-04 from the per-spike result files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caido_version",
    "generated_at",
    "source_runs",
    "thresholds",
    "gates",
    "unresolved"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "caido_version": {
      "type": "string",
      "const": "0.57.1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_runs": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "array"
        ]
      }
    },
    "thresholds": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "AST_MAX_BYTES",
          "BODY_LENGTH_EQUALS_RAW_LENGTH",
          "BODY_STORED_DECOMPRESSED",
          "CACHED_RESPONSES_REACH_HOOK",
          "CACHE_CROSS_DAY_DENOMINATOR",
          "CACHE_HIT_RATE_ASSUMED",
          "CACHE_HIT_RATE_CROSS_DAY",
          "CACHE_HIT_RATE_WITHIN_PAGE",
          "CACHE_HIT_RATE_WITHIN_SESSION",
          "CACHE_SAMPLE_DAYS",
          "DB_SURVIVES_REINSTALL",
          "EVENTS_DELIVERED_UNDER_BLOCK",
          "EVENT_OVERFLOW_BEHAVIOUR",
          "FS_CONTAINMENT_STRATEGY",
          "FS_HAS_LSTAT",
          "FS_HAS_REALPATH",
          "HANDLER_ERROR_SURFACED",
          "HARD_MAX_BYTES",
          "MAX_NESTING_DEPTH",
          "MAX_SYNC_SLICE_MS",
          "MULTISTATEMENT_EXEC_ATOMIC",
          "PARSE_MS_PER_MB",
          "PLUGINS_FALSE_SUPPRESSES_INTERCEPT",
          "PLUGIN_TOGGLE_RESETS_LEAK",
          "PRAGMA_PERSISTS_ACROSS_EXEC",
          "RE2JS_THROUGHPUT_RATIO",
          "RE2JS_VERDICT",
          "REDOS_INTERRUPTIBLE",
          "REDOS_RECOVERY",
          "RETROACTIVE_SCAN_MANDATORY",
          "RSS_BYTES_PER_INPUT_BYTE",
          "SAVE_FALSE_SUPPRESSES_INTERCEPT",
          "SEND_CLIFF_FETCH",
          "SEND_CLIFF_SAVE_FALSE",
          "SEND_CLIFF_SAVE_TRUE",
          "SEND_FAILURE_MODE",
          "SEND_REFIRES_INTERCEPT",
          "SIZE_GATE_SOURCE",
          "STACK_FAILURE_MODE",
          "STATUS_304_REACHES_HOOK",
          "STRUCTURED_CLONE_PRESENT",
          "SURFACES_FIRING_INTERCEPT",
          "TEXTDECODER_MODULE",
          "TOKENIZER_MS_PER_MB",
          "TRANSACTION_PERSISTS_ACROSS_EXEC",
          "TRIVIAL_STACK_DEPTH",
          "WAL_ENABLED",
          "WASM_PRESENT",
          "YIELD_COST_MS",
          "YIELD_PRIMITIVE"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "unit",
          "spike",
          "confidence"
        ],
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ],
            "description": "Nullable ONLY to carry the single inconclusive case plan 00-04 task 3 defines for the cross-day cache rate. Every other threshold in the phase must resolve to a real value."
          },
          "unit": {
            "type": "string"
          },
          "spike": {
            "type": "string",
            "pattern": "^SPIKE-[0-9]{2}[a-z]?$"
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW",
              "PENDING",
              "pessimistic-default"
            ],
            "description": "pessimistic-default is NOT a weak measurement \u2014 it is the absence of one. It marks a value nobody measured, deliberately chosen as the worst case so a downstream phase can budget against it without being told a number was observed. Folding it into LOW would erase exactly the distinction a later reader needs."
          },
          "status": {
            "enum": [
              "resolved",
              "inconclusive",
              "pending"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "revisit_after": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "status": {
              "const": "inconclusive"
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "revisit_after"
          ]
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spike",
          "question",
          "answer",
          "status",
          "blocks",
          "changes_if_wrong"
        ],
        "properties": {
          "spike": {
            "type": "string",
            "pattern": "^SPIKE-[0-9]{2}[a-z]?$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "inconclusive",
              "blocked"
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changes_if_wrong": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "revisit_after": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Host and binary the whole phase was measured on, folded in by scripts/spike/aggregate.py after asserting every contributing result agrees. It lives HERE rather than being fetched from the per-spike results by the renderer, so 00-GO-NO-GO.md can be generated from this file ALONE and the render-and-diff check actually proves the prose and the data cannot diverge.",
      "additionalProperties": false,
      "properties": {
        "binary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "expected_version": {
              "type": "string"
            },
            "reported_version": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "host": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "os": {
              "type": "string"
            },
            "release": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "cpu": {
              "type": "string"
            },
            "cores": {
              "type": [
                "integer",
                "null"
              ]
            },
            "ram_gb": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}