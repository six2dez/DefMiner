node_modules/
dist/
.DS_Store

# --- Phase 0 spike harness -------------------------------------------------
# Corpus bundles are fetched by scripts/spike/fetch-corpus.sh and verified
# against SHA-256 hashes committed in that script. The script and hashes are
# the reproducible artifact; the 22 MB of vendor JS is not.
corpus/

# Long-lived recorder state, including the SPIKE-10 cache_log database. That
# database records URLs from the operator's real proxied browsing and must
# never enter git history.
.spike/

# Built probe packages — regenerated from probe/<name>/ on every run.
probe/*.zip
tier1/*/dist/

# CREDENTIAL AND PRIVACY CONTROL (threat T-00-14).
# Guest bearer tokens and raw host logs live under results/runs/. The logs can
# contain the operator's real browsing URLs; the token is live credential
# material. Anything a result legitimately needs from a log is extracted into
# the result JSON by scripts/spike/record-result.py — the raw log never ships.
# Result JSON, rss.csv and raw/*.jsonl ARE committed; these two are not.
.planning/phases/00-runtime-reality-check/results/runs/*/token
.planning/phases/00-runtime-reality-check/results/runs/*/*.log

# The SAME control for Phase 1. The rules above are Phase-0-path-specific, and
# Phase 1's scripts source the same instance.sh into a DIFFERENT results root —
# so without these two lines a run that died before teardown could commit a live
# guest bearer token, and every run would commit host logs carrying the
# operator's real browsing URLs (threat T-00-14, and T-01-05 here).
.planning/phases/01-skeleton-persistence-compatibility/results/runs/*/token
.planning/phases/01-skeleton-persistence-compatibility/results/runs/*/*.log
.planning/phases/01-skeleton-persistence-compatibility/results/runs/*/raw/*.log

# The SAME control for Phase 6 (threats T-00-14, T-06-10). Phase 6's probes
# source the same instance.sh into a THIRD results root, and the rules above are
# path-specific — without these lines a run that died before teardown could
# commit a live guest bearer token, and every run would commit host logs carrying
# whatever the instance proxied.
.planning/phases/06-retroactive-scan-deployment-reality/results/runs/*/token
.planning/phases/06-retroactive-scan-deployment-reality/results/runs/*/*.log
.planning/phases/06-retroactive-scan-deployment-reality/results/runs/*/raw/*.log

# The SAME control for Phase 7 (threats T-00-14, T-07-19). scripts/phase7/map-bytes.sh
# sources the SAME instance.sh into a FOURTH results root, and every rule above is
# path-specific — so without these lines a run that died before teardown could commit a
# live guest bearer token (instance.sh mints one under `umask 077`, chmod 600, and
# deletes it at teardown — but only if teardown runs), and every run would commit host
# logs. Everything a result legitimately needs from a log is extracted into
# map-bytes.json by scripts/phase7/record-point.py; the raw log never ships. rss.csv and
# raw/*.json ARE committed — they are the evidence.
.planning/phases/07-sourcemap-reconstruction/results/runs/*/token
.planning/phases/07-sourcemap-reconstruction/results/runs/*/*.log
.planning/phases/07-sourcemap-reconstruction/results/runs/*/raw/*.log

# Per-operation stderr captures copied into runs/*/raw/ by scripts/spike/ladder.sh.
# The rule above only covers runs/*/*.log, one level up. These are the channel a
# C-level QuickJS abort would land in, so they are CHECKED — the scan result is
# recorded inside the spike result itself — but like every other raw host log
# they do not ship (threats T-00-14, T-00-26).
.planning/phases/00-runtime-reality-check/results/runs/*/raw/*.log

# SPIKE-11's browsing apparatus, built fresh by scripts/spike/run-spike-11.sh on
# every run. The web root is two copies of a corpus bundle (corpus/ is already
# ignored) plus four generated HTML wrappers; the Chromium profile is a 3.4 MB
# throwaway holding the very disk cache the spike manipulates; the per-run CA is
# minted by the instance and dies with it. All three are regenerable and none is
# evidence — everything the result quotes is extracted into spike-11-cache.json.
.planning/phases/00-runtime-reality-check/results/runs/*/raw/webroot/
.planning/phases/00-runtime-reality-check/results/runs/*/raw/chromium-profile/
.planning/phases/00-runtime-reality-check/results/runs/*/raw/*.crt

# Raw host-log copies preserved next to the SPIKE-04 journals by
# scripts/spike/send-cliff.sh. They are copied out of the data path BEFORE
# teardown deletes it, because a C-level abort under panic="abort" lands on
# stderr and nowhere else and must be scannable offline — but they are the same
# raw host logs as runs/*/*.log and ship for the same reason: never. Everything
# a result legitimately needs from them (the abort-signature scan, its hit
# counts and samples) is extracted into results/SPIKE-04*.json.
# The journal .db files DO ship: they are the evidence, they are small, and the
# only URL they carry is the probe's own synthetic target with query values
# already redacted by the probe.
.planning/phases/00-runtime-reality-check/results/spike-04-runs/*/*.log

# Byte-compiled Python from importing the spike analysers as modules.
scripts/spike/__pycache__/

# Incremental typecheck state written by `tsc --build` (plan 01-02). Derived
# from the sources and the tsconfigs, regenerated on every run, and machine- and
# path-specific — never evidence.
*.tsbuildinfo

# Caido CLI releases downloaded by scripts/phase1/fetch-caido.sh for the
# COMPAT-02 smoke test. Regenerable by that script, which verifies the release's
# published SHA-512 BEFORE extracting anything. A vendored Caido binary must
# never enter git history: it is ~100 MB of third-party executable, it is not
# evidence (the evidence is the recorded hash in results/compat-smoke.json and
# the sidecar release.json), and committing an executable this repo does not
# build is exactly the supply-chain shape threat T-01-30 is about.
.caido-bin/

# GSD session lock — holds a live pid and session id; never belongs in git.
.planning/milestone.lock

# GSD machine mirror of the roadmap, regenerated by gsd-tools on demand. First
# written during plan 05-12's close-out and DERIVED, not authored: it listed
# every phase as `pending` while STATE.md and ROADMAP.md recorded Phase 5 at
# twelve of twelve. Committing it would put a second, disagreeing answer to
# "where is this project" into history beside the two authoritative surfaces.
.planning/state.json

# Two run directories left untracked (gap-closure round 10 disposition, 2026-08-26).
# NOTE: 390 sibling files under these same results/runs/ paths ARE tracked — see
# the token/log/cert exclusions above. These two are excluded by decision, not by
# convention; drop these lines and `git add` them to bring them in line.
.planning/phases/00-runtime-reality-check/results/runs/recorder-20260820T180307Z/
.planning/phases/01-skeleton-persistence-compatibility/results/runs/20260821T075936Z-12874/

# GSD research digest cache (tooling-local, not source)
.planning/research/.cache/

# Transient lint fixtures written by scripts/ci/lint-r1.spec.ts. Never committed:
# they contain deliberate v-html / eval violations and exist only for the
# duration of that spec.
packages/frontend/src/__r1_fixtures__/

# Written and removed by tests/frontend-load.spec.ts for the life of one run.
# It builds the real InventoryTable through the real vite/PostCSS pipeline so a
# browser can measure the geometry jsdom cannot, and a crashed run must not leave
# a build artifact behind that `pnpm lint` then reports.
packages/frontend/.load-harness/
