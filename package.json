{
  "name": "defminer",
  "version": "1.0.0",
  "description": "DefMiner — passive JavaScript analysis for Caido",
  "scripts": {
    "test": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "knip": "knip",
    "gen:thresholds": "node scripts/ci/gen-thresholds.mjs",
    "build:backend": "caido-dev build packages",
    "check:bundle": "node scripts/ci/check-bundle-imports.mjs"
  },
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@caido-community/dev": "0.1.7",
    "@caido/eslint-config": "0.10.0",
    "@caido/sdk-client": "0.5.0",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@types/node": "26.2.0",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.2",
    "knip": "5.86.0",
    "meriyah": "7.3.2",
    "playwright": "1.62.1",
    "prettier": "3.8.1",
    "re2js": "2.8.6",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  },
  "private": true
}
