{
  // Type-information program for ESLint ONLY. @caido/eslint-config@0.10.0 turns
  // on typed typescript-eslint rules (await-thenable and friends), which need a
  // TS program covering every linted file — including this repo's plain .mjs
  // gates, the Phase 0 specs and the root config files, none of which belong to
  // a package project.
  //
  // This is NOT the typecheck. `pnpm typecheck` runs `tsc --build` against
  // packages/engine and packages/backend with their own narrow `types` arrays,
  // and THAT is where the DET-03 boundary is enforced. This file deliberately
  // carries both type sets and `allowJs`, because its only job is to give the
  // linter a program; loosening it cannot loosen the boundary.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "@caido/quickjs-types"],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "packages/**/*.ts",
    // Phase 5's frontend. `.vue` is here because typescript-eslint needs a file
    // to be IN the program before it will type it, and the Vue parser feeds
    // single-file components in through `extraFileExtensions`; `.cjs` is here
    // for packages/frontend/postcss.config.cjs. Neither extension is picked up
    // by plain `tsc` — the solution build in tsconfig.json still sees only .ts,
    // which is exactly the split packages/frontend/tsconfig.json documents.
    "packages/**/*.vue",
    "packages/**/*.cjs",
    // `tests/**`, not the one named spec plan 01-02 authored. Which tests are
    // LINTED is eslint.config.js's decision (it names the Phase 0 gates it
    // deliberately leaves alone); this file only has to supply a type program
    // for whichever files that decision lets through. Naming them one at a time
    // here meant every new tests/ spec failed with a parsing error until
    // somebody remembered this file — which is a papercut, not a gate.
    "tests/**/*.ts",
    "scripts/ci/**/*.ts",
    "scripts/ci/**/*.mjs",
    "scripts/ci/**/*.mts",
    // Phase 6's own generators. `scripts/spike/**` is deliberately absent — it
    // is Phase 0 evidence eslint.config.js ignores wholesale — but
    // `scripts/phase6/**` is code THIS milestone authors, so it is linted like
    // everything else and therefore needs a program to be placed in.
    "scripts/phase6/**/*.mjs",
    "*.ts",
    "*.js",
    "*.mjs"
  ]
}
